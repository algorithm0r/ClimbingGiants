<?xml version="1.0" encoding="UTF-8"?>
<!-- The example reports link these programs as downloads. The host is IIS, which
     answers 404 for an extension it has no MIME type for, and .py is one. Scoped
     to this folder (as pagefind/ does for search) so a refusal can only break
     these downloads. Remove-then-add, so a type defined higher up is not
     declared twice, which IIS answers with a 500. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".py" />
      <mimeMap fileExtension=".py" mimeType="text/plain" />
    </staticContent>
  </system.webServer>
</configuration>
